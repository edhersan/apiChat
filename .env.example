# ── Obligatorias ─────────────────────────────────────────────

# API key de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_clave_de_gemini

# Clave compartida que usará la app Expo en el header X-API-Key.
# Genera una con: openssl rand -hex 32
APP_API_KEY=tu_clave_para_la_app

# ── Opcionales ───────────────────────────────────────────────

# Modelo de Gemini
GEMINI_MODEL=gemini-3.5-flash-lite

# Origen(es) permitidos por CORS: "*" o lista separada por comas
CORS_ORIGIN=*

# Puerto local (Vercel lo asigna solo en producción)
PORT=3000
