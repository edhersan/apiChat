# ── Obligatoria ──────────────────────────────────────────────

# API key de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_clave_de_gemini

# ── Opcionales ───────────────────────────────────────────────

# Modelo de Gemini (debe soportar function calling)
GEMINI_MODEL=gemini-3.5-flash-lite

# Origen(es) permitidos por CORS: "*" o lista separada por comas
CORS_ORIGIN=*

# Puerto local (Vercel lo asigna solo en producción)
PORT=3000

# APIs cuyas bases de datos alimentan al asistente (opcionales: hay valores por defecto)
POKEMON_API_URL=https://pokemon-api-edhersan.vercel.app
GAMES_API_URL=https://games-api-iota.vercel.app
PROFESORES_API_URL=https://docentes-api.vercel.app

# Timeout en ms para consultar las APIs de datos
DATA_API_TIMEOUT_MS=8000

# TTL en ms del índice de catálogo en memoria
CATALOG_INDEX_TTL_MS=300000
